rules_version = '2';

// Members can only see their own profile and loans, and can only change a book's
// stock by 1 (borrow/return). Admins (role "admin") can manage everything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function bookPath(bookId) {
      return /databases/$(database)/documents/books/$(bookId);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // sign up always creates a member with no loans
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.activeBookIds.size() == 0;

      // members can only change their own activeBookIds
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && changedOnly(['activeBookIds'])
            && request.resource.data.activeBookIds.size() <= 3);

      allow delete: if false;
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();

      // borrow/return: stock moves by one, nothing else changes
      allow update: if isAdmin()
        || (signedIn()
            && changedOnly(['availableCopies'])
            && math.abs(request.resource.data.availableCopies - resource.data.availableCopies) <= 1
            && request.resource.data.availableCopies >= 0
            && request.resource.data.availableCopies <= resource.data.totalCopies);
    }

    match /loans/{loanId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // a new loan has to be your own and has to take a copy off the shelf in the same transaction
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'BORROWED'
        && getAfter(bookPath(request.resource.data.bookId)).data.availableCopies
             == get(bookPath(request.resource.data.bookId)).data.availableCopies - 1;

      // members can only close their own loan
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'BORROWED'
            && request.resource.data.status == 'RETURNED'
            && changedOnly(['status', 'returnedAt']));

      allow delete: if false;
    }
  }
}
